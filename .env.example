# Local development only. Do not use these credentials outside your machine.
POSTGRES_DB=tokojojo
POSTGRES_USER=tokojojo
POSTGRES_PASSWORD=tokojojo_dev
DATABASE_URL=postgresql://tokojojo:tokojojo_dev@127.0.0.1:5432/tokojojo
# Development-only server pepper. Replace with a 32-byte secret in production.
PASSWORD_PEPPER=tokojojo_development_pepper_change_me
PASSWORD_PEPPER_VERSION=1
# Production PASETO signing keys live in podman secrets/env, never the database.
# PASETO_ACTIVE_KID=v1
# PASETO_ACTIVE_PRIVATE_KEY=<base64url raw 32-byte Ed25519 seed>
# PASETO_ACTIVE_PUBLIC_KEY=<base64url raw 32-byte Ed25519 public key>
# PASETO_PREVIOUS_KID=v0
# PASETO_PREVIOUS_PUBLIC_KEY=<base64url raw 32-byte Ed25519 public key>
# Offline tokens are Tauri-only: 7-day validity plus a 7-day grace window.
# OFFLINE_TOKEN_TTL_MS=604800000
# OFFLINE_TOKEN_GRACE_MS=604800000
# Offline batch order limit (default 50, hard cap 100).
# OFFLINE_SYNC_MAX_ORDERS=50
# GraphQL abuse limits.
# GRAPHQL_MAX_DEPTH=15
# GRAPHQL_MAX_COMPLEXITY=1000
