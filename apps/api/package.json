{
  "name": "@tokojojo/api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:docs": "tsx scripts/generate-schema-docs.ts",
    "db:docs:check": "pnpm db:docs && git -C ../.. diff --exit-code -- apps/api/SCHEMA.md apps/api/schema.dbml",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file-if-exists=../../.env --import tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "schema:export": "node --import tsx scripts/export-schema.ts",
    "schema:check": "node --import tsx scripts/check-schema-drift.ts",
    "test": "node --env-file-if-exists=../../.env --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@graphql-yoga/plugin-disable-introspection": "3.1.1",
    "@node-rs/argon2": "2.2.2",
    "@pothos/core": "4.18.1",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "graphql": "16.14.2",
    "graphql-yoga": "6.1.1",
    "postgres": "4.1.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "drizzle-docs-generator": "0.8.2",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
